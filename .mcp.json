{
  "$comment": "Servidores MCP de Hostinger, compartidos por el repo. Viajan a cualquier máquina que haga checkout, incluidas las sesiones de nube, que es el punto: el conector hosteado de Hostinger devuelve 403 y por aquí no hace falta. El token NUNCA va aquí: se lee de la variable de entorno HOSTINGER_API_TOKEN (en local, variable de usuario de Windows; en la nube, 'Edit environment'). Mismo patrón que CLOUDFLARE_API_TOKEN. Las operaciones que gastan dinero o son irreversibles están bloqueadas en .claude/settings.json.",
  "mcpServers": {
    "hostinger-reach": {
      "command": "npx",
      "args": ["--package=hostinger-api-mcp@latest", "hostinger-reach-mcp"],
      "env": { "HOSTINGER_API_TOKEN": "${HOSTINGER_API_TOKEN}" }
    },
    "hostinger-dns": {
      "command": "npx",
      "args": ["--package=hostinger-api-mcp@latest", "hostinger-dns-mcp"],
      "env": { "HOSTINGER_API_TOKEN": "${HOSTINGER_API_TOKEN}" }
    },
    "hostinger-domains": {
      "command": "npx",
      "args": ["--package=hostinger-api-mcp@latest", "hostinger-domains-mcp"],
      "env": { "HOSTINGER_API_TOKEN": "${HOSTINGER_API_TOKEN}" }
    },
    "hostinger-hosting": {
      "command": "npx",
      "args": ["--package=hostinger-api-mcp@latest", "hostinger-hosting-mcp"],
      "env": { "HOSTINGER_API_TOKEN": "${HOSTINGER_API_TOKEN}" }
    },
    "hostinger-billing": {
      "command": "npx",
      "args": ["--package=hostinger-api-mcp@latest", "hostinger-billing-mcp"],
      "env": { "HOSTINGER_API_TOKEN": "${HOSTINGER_API_TOKEN}" }
    },
    "hostinger-vps": {
      "command": "npx",
      "args": ["--package=hostinger-api-mcp@latest", "hostinger-vps-mcp"],
      "env": { "HOSTINGER_API_TOKEN": "${HOSTINGER_API_TOKEN}" }
    },
    "hostinger-ecommerce": {
      "command": "npx",
      "args": ["--package=hostinger-api-mcp@latest", "hostinger-ecommerce-mcp"],
      "env": { "HOSTINGER_API_TOKEN": "${HOSTINGER_API_TOKEN}" }
    }
  }
}
