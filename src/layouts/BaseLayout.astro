---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /**
   * Imagen del recuadro que sale al compartir el enlace (WhatsApp, Telegram,
   * Instagram, X). Vive en `public/` y **tiene que medir 1200 × 630**: las
   * etiquetas `og:image:width`/`height` de abajo prometen ese tamaño, y varias
   * apps deciden con ellas si dibujan el recuadro grande o una miniatura.
   * La de por defecto es el logo sobre hueso: se comparte más el enlace de la
   * marca que el de una pieza suelta.
   */
  image?: string;
  imageAlt?: string;
  themeColor?: string;
}

const {
  title,
  description = 'Configura tu lámpara Forma: elige modelo de pantalla y el color de cada pieza.',
  image = '/images/og-default.jpg',
  imageAlt = 'El logo de forma.',
  themeColor = '#FFFFFF',
} = Astro.props;

const imageURL = new URL(image, Astro.site);

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// El sufijo es la marca, "forma", no el dominio: así se lee el recuadro al
// compartir el enlace y así se lee la pestaña. La portada ya se titula "forma",
// y ahí el sufijo sobraría.
const fullTitle = title === 'forma' ? title : `${title} | forma`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={themeColor} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:site_name"   content="forma" />
    <meta property="og:locale"      content="es_MX" />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image"        content={imageURL} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt"    content={imageAlt} />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={imageURL} />
    <meta name="twitter:image:alt"   content={imageAlt} />

    <slot name="head" />
  </head>
  <body style={`background-color: ${themeColor}`}>
    <slot />
  </body>
</html>
