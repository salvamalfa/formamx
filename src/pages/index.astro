---
import BaseLayout from '../layouts/BaseLayout.astro';
import LampConfigurator from '../components/LampConfigurator.tsx';
import { baseSrc, pantallaSrc, COLORS, MODELS, DEFAULTS } from '../config/lamps';

const defaultModel = MODELS.find((m) => m.id === DEFAULTS.modelId)!;
const defaultPantalla = COLORS.find((c) => c.id === DEFAULTS.pantallaColorId)!;
const defaultTapa = COLORS.find((c) => c.id === DEFAULTS.tapaColorId)!;
---

<BaseLayout
  title="Diseña tu lámpara"
  description="Configura tu lámpara Forma: elige modelo de pantalla y el color de cada pieza, y mírala al instante."
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={pantallaSrc(defaultModel, defaultPantalla)} />
    <link rel="preload" as="image" href={baseSrc(defaultTapa)} />
  </Fragment>

  <main class="relative h-dvh overflow-hidden">
    <h1 class="sr-only">Diseña tu lámpara</h1>
    <LampConfigurator client:load />
  </main>
</BaseLayout>
