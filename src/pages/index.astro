---
// Portada "Bitácora" — diseño forma - Bitácora.dc.html de Claude Design,
// implementado con el brand kit de forma (variantes por defecto del diseño:
// portada editorial, ambiente noche, bitácora en galería).
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import logoBlanco from '../assets/brand/forma-blanco.svg';
import sillaJardin from '../assets/photos/banca.jpeg';
import lampBase from '../assets/lamps/base/TesseraLamp_CuerpoTapa_Azul.png';
import lampShade from '../assets/lamps/pantalla/TesseraLamp_Pantalla_Azul.png';
---

<BaseLayout
  title="forma"
  description="Taller de proyectos de una persona: bancas, lámparas, videos, música. Cada pieza se hace una vez."
  themeColor="#1E1A14"
>
  <main class="brand-forma min-h-dvh bg-[var(--tinta)] text-[var(--crema)]">
    <!-- Cabecera -->
    <header class="mx-auto flex max-w-[1100px] items-center justify-between gap-6 px-6 py-5 sm:px-12">
      <a href="/" aria-label="forma — inicio" class="shrink-0">
        <Image src={logoBlanco} alt="forma" class="block h-[30px] w-auto" />
      </a>
      <nav class="flex items-center gap-4 sm:gap-7">
        <a href="/" class="text-[15px] font-semibold text-[var(--crema)] no-underline">Bitácora</a>
        <a href="#bitacora" class="text-[15px] text-[var(--crema-oscuro)] no-underline">Piezas</a>
        <span class="cursor-default text-[15px] text-[var(--crema-oscuro)]">Quién</span>
        <a href="mailto:hola@forma.mx" class="btn btn-sm btn-support">Escríbeme</a>
      </nav>
    </header>

    <!-- Hero editorial -->
    <section
      class="mx-auto grid max-w-[1100px] items-center gap-12 px-6 pt-12 sm:px-12 md:grid-cols-[1.1fr_1fr]"
    >
      <div>
        <p class="meta-caps m-0 text-[var(--naranja-claro)]">Taller de proyectos — Desde 2026</p>
        <h1
          class="m-0 mt-3.5 text-[length:var(--display-lg)] font-bold leading-[var(--leading-display)] tracking-[var(--tracking-display)] text-[var(--crema)] md:text-[length:var(--display-xl)]"
          style="font-family: var(--font-display)"
        >
          Cada pieza se hace una vez.
        </h1>
        <p class="m-0 mt-[18px] max-w-[440px] text-[length:var(--text-lg)] leading-[var(--leading-body)] text-[var(--crema-oscuro)]">
          Bancas, lámparas, videos, música. Lo que sale bien y lo que se quema,
          documentado. Se vende, si quieres — pero primero la historia.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="#bitacora" class="btn btn-lg btn-primary no-underline">Ver la bitácora</a>
          <span class="btn btn-lg btn-ghost">Quién soy →</span>
        </div>
      </div>
      <Image
        src={sillaJardin}
        alt="silla de jardín al sol"
        widths={[600, 1000, 1400]}
        sizes="(min-width: 768px) 480px, 100vw"
        class="h-[380px] w-full rounded-[var(--radius-l)] object-cover"
      />
    </section>

    <!-- Bitácora -->
    <section id="bitacora" class="mx-auto max-w-[1100px] px-6 py-16 sm:px-12">
      <div class="flex flex-wrap items-baseline justify-between gap-6">
        <h2
          class="m-0 text-[length:var(--display-md)] font-bold text-[var(--crema)]"
          style="font-family: var(--font-display)"
        >
          Bitácora
        </h2>
        <div class="flex flex-wrap gap-2">
          <button type="button" class="chip activo" data-cat-btn="todos">todos</button>
          <button type="button" class="chip" data-cat-btn="madera">madera</button>
          <button type="button" class="chip" data-cat-btn="impresión 3d">impresión 3d</button>
          <button type="button" class="chip" data-cat-btn="video">video</button>
        </div>
      </div>

      <div class="mt-6 grid gap-6 md:grid-cols-3">
        <ProjectCard
          cat="madera"
          image={sillaJardin}
          imageAlt="Silla de jardín"
          meta={['Proyecto 001', '2026.04', 'Pino']}
          title="Silla de jardín"
          note="La primera capa quedó chueca. La segunda, mejor."
          tags={['madera', 'exterior']}
          unique
          href="/banca"
        />
        <ProjectCard
          cat="impresión 3d"
          meta={['Proyecto 002', 'En proceso', 'PLA']}
          title="Lámpara impresa"
          note="Tercer intento del difusor. Los dos primeros se doblaron."
          tags={['impresión 3d', 'luz']}
          href="/lampara"
        >
          <div slot="media" class="relative h-[210px] w-full bg-[var(--crema-oscuro)]">
            <Image
              src={lampBase}
              alt=""
              aria-hidden="true"
              widths={[400, 800]}
              sizes="(min-width: 768px) 340px, 100vw"
              class="absolute inset-3 h-[calc(100%-1.5rem)] w-[calc(100%-1.5rem)] object-contain"
            />
            <Image
              src={lampShade}
              alt="Lámpara Tessera azul"
              widths={[400, 800]}
              sizes="(min-width: 768px) 340px, 100vw"
              class="absolute inset-3 h-[calc(100%-1.5rem)] w-[calc(100%-1.5rem)] object-contain"
            />
          </div>
        </ProjectCard>
        <ProjectCard
          cat="video"
          placeholder="grabando"
          meta={['Proyecto 003', 'Pronto']}
          title="Video: el jardín en junio"
          note="Grabando las tardes. Sin guion, con pájaros."
          tags={['video', 'naturaleza']}
        />
      </div>
    </section>

    <!-- Pie con aviso por correo -->
    <footer class="border-t border-[rgba(246,238,221,0.15)] bg-[var(--surface-inverse)] px-6 py-14 sm:px-12">
      <div class="mx-auto flex max-w-[1100px] flex-wrap items-center justify-between gap-12">
        <div>
          <Image src={logoBlanco} alt="forma" class="block h-[26px] w-auto" />
          <p class="m-0 mt-3.5 max-w-[340px] text-sm leading-[1.6] text-[var(--naranja-claro)]">
            Sin algoritmo de por medio: te escribo cuando hay pieza nueva. Poco y de vez
            en cuando.
          </p>
        </div>
        <form class="flex items-end gap-2.5" novalidate>
          <input
            type="email"
            class="input-brand w-[220px] sm:w-[260px]"
            placeholder="tu@correo.com"
            aria-label="Tu correo"
          />
          <button type="button" class="btn btn-primary">Avísame</button>
        </form>
      </div>
    </footer>
  </main>

  <script>
    // Filtro de categorías de la bitácora (equivalente al setState del prototipo).
    const chips = document.querySelectorAll<HTMLButtonElement>('[data-cat-btn]');
    const cards = document.querySelectorAll<HTMLElement>('[data-cat]');
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const cat = chip.dataset.catBtn!;
        chips.forEach((c) => c.classList.toggle('activo', c === chip));
        cards.forEach((card) => {
          card.style.display = cat === 'todos' || card.dataset.cat === cat ? '' : 'none';
        });
      });
    });
  </script>
</BaseLayout>
