---
// Portada-menú, como atlason.com: una foto a pantalla completa y, encima, un
// panel blanco con tres columnas (forma · Trabajos · Más). Cada columna es
// una versión reducida de su página y la columna entera es el enlace; al
// abrirla, la transición de vista la hace crecer hasta ocupar la pantalla
// (src/styles/portada.css, @view-transition).
import '../styles/portada.css';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ColumnaForma from '../components/portada/ColumnaForma.astro';
import ColumnaTrabajos from '../components/portada/ColumnaTrabajos.astro';
import ColumnaMas from '../components/portada/ColumnaMas.astro';
import fondo from '../assets/photos/banca.jpeg';
---

<BaseLayout
  title="forma"
  description="Taller de proyectos de una persona: bancas, lámparas, videos, música."
>
  <main class="brand-forma portada relative min-h-dvh text-[var(--text-body)]">
    <Image
      src={fondo}
      alt=""
      aria-hidden="true"
      widths={[1000, 1600, 2400]}
      sizes="100vw"
      loading="eager"
      class="fondo fixed inset-0 -z-10 h-full w-full object-cover object-[35%_40%]"
    />

    <div class="panel mx-auto flex max-w-[1440px] flex-col md:grid md:grid-cols-[1.15fr_1fr_0.9fr]">
      <a href="/forma" class="columna" aria-label="forma: quién está detrás" style="view-transition-name: col-forma">
        <ColumnaForma menu />
      </a>
      <a href="/trabajos" class="columna" aria-label="Trabajos: todas las piezas" style="view-transition-name: col-trabajos">
        <ColumnaTrabajos menu />
      </a>
      <a href="/mas" class="columna" aria-label="Más: avisos por correo" style="view-transition-name: col-mas">
        <ColumnaMas menu />
      </a>
    </div>
  </main>
</BaseLayout>

<style>
  /* El panel flota sobre la foto con el mismo aire por los cuatro lados. En
     escritorio tiene altura fija y cada columna recorta lo que no cabe, como
     en atlason: es un menú, no la página. En móvil las columnas se apilan. */
  .portada .panel {
    background: var(--surface-page);
    border-radius: var(--radius-l);
    margin: 4vh 4vw;
    width: 92vw;
    overflow: hidden;
    box-shadow: var(--shadow-raised);
  }

  @media (min-width: 768px) {
    .portada .panel {
      margin: 8vh auto;
      width: 90vw;
      height: 84vh;
      max-height: 860px;
    }
  }

  .portada .columna {
    display: block;
    position: relative;
    padding: 24px 20px;
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    border-bottom: 1px solid var(--border-soft);
    transition: background var(--duration-slow) var(--ease-out);
  }

  .portada .columna:last-child { border-bottom: 0; }
  .portada .columna:hover { background: var(--hueso); }
  .portada .columna:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: -2px; }

  /* En móvil solo la columna forma desborda; las otras dos se ven enteras. */
  .portada .columna:first-child { max-height: 72vh; }

  @media (min-width: 768px) {
    .portada .columna {
      height: 100%;
      padding: 32px 28px;
      border-bottom: 0;
      border-right: 1px solid var(--border-soft);
    }
    .portada .columna:first-child { max-height: none; }
    .portada .columna:last-child { border-right: 0; }

    /* Degradado al pie de las columnas que sí se recortan (forma y Trabajos):
       se nota que hay más abajo. Más es corta y se ve entera. */
    .portada .columna:not(:last-child)::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 72px;
      background: linear-gradient(to bottom, transparent, var(--surface-page));
      pointer-events: none;
      transition: opacity var(--duration-slow) var(--ease-out);
    }

    .portada .columna:hover::after { opacity: 0; }
  }

  @media (min-width: 1200px) {
    .portada .columna { padding: 40px 36px; }
  }
</style>
