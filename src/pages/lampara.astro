---
import BaseLayout from '../layouts/BaseLayout.astro';
import LampConfigurator from '../components/LampConfigurator.tsx';
import { buildLampImageManifest } from '../lib/lampImages';
import { baseKey, pantallaKey, COLORS, MODELS, DEFAULTS } from '../config/lamps';

const manifest = await buildLampImageManifest();

const defaultModel = MODELS.find((m) => m.id === DEFAULTS.modelId)!;
const defaultPantalla = COLORS.find((c) => c.id === DEFAULTS.pantallaColorId)!;
const defaultTapa = COLORS.find((c) => c.id === DEFAULTS.tapaColorId)!;
const preloads = [
  manifest[pantallaKey(defaultModel, defaultPantalla)],
  manifest[baseKey(defaultTapa)],
];
---

<BaseLayout
  title="Diseña tu lámpara"
  description="Configura tu lámpara Forma: elige modelo de pantalla y el color de cada pieza, y mírala al instante."
>
  <Fragment slot="head">
    {preloads.map((image) => (
      <link
        rel="preload"
        as="image"
        href={image.src}
        imagesrcset={image.srcset}
        imagesizes="100vw"
      />
    ))}
  </Fragment>

  <main class="brand-forma relative h-dvh overflow-hidden bg-[var(--surface-page)] text-[var(--tinta)]">
    <LampConfigurator client:load manifest={manifest} />
  </main>
</BaseLayout>
