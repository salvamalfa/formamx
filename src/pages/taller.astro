---
// Dashboard privado del taller: cola de pedidos + estado del AMS. Vive en el
// sitio estático pero habla con el Worker por bearer (token en localStorage).
// El manifest de imágenes se genera en build, igual que en /lampara, para
// reusar exactamente las mismas capas del configurador en el preview.
import BaseLayout from '../layouts/BaseLayout.astro';
import TallerShell from '../components/taller/TallerShell.tsx';
import { buildLampImageManifest } from '../lib/lampImages';

const manifest = await buildLampImageManifest();
---

<!-- themeColor pinta el <body>; sin él queda blanco puro contra el --hueso
     de la página y se ve una franja clara en el overscroll. -->
<BaseLayout title="Taller" description="Cola de pedidos del taller." themeColor="#f7f7f5">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <main class="brand-forma min-h-dvh bg-[var(--hueso)] text-[var(--text-body)]">
    <TallerShell client:only="preact" manifest={manifest} />
  </main>
</BaseLayout>
