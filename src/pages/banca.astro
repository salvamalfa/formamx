---
// Página de proyecto "La banca de los abuelos", con el brand kit de forma:
// blanco/tinta, Alan Sans en todo (metadata en mayúsculas y azul taller),
// ficha de compra como tarjeta blanca con el CTA azul del kit.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import BuyBanca from '../components/BuyBanca.tsx';
import logoNegro from '../assets/brand/forma-negro.svg';
import bancaPhoto from '../assets/photos/banca.jpeg';
---

<BaseLayout
  title="La banca de los abuelos"
  description="Una silla baja para leer en el jardín, hecha para dos personas que ya no tienen prisa. Pieza única en venta."
>
  <main class="brand-forma min-h-dvh bg-[var(--surface-page)] pb-20 pt-10 text-[var(--text-body)]">
    <div class="mx-auto max-w-[640px] px-6">
      <header class="mb-10 flex items-center justify-between">
        <a href="/" aria-label="forma — inicio" class="shrink-0">
          <Image src={logoNegro} alt="forma" class="block h-6 w-auto" />
        </a>
        <span class="meta-caps text-[var(--text-faint)]">Proyecto 001</span>
      </header>

      <h1
        class="m-0 text-[length:var(--display-lg)] font-bold leading-[var(--leading-display)] tracking-[var(--tracking-display)]"
        style="font-family: var(--font-display)"
      >
        La banca de los abuelos
      </h1>
      <p class="meta-caps m-0 mt-3 text-[var(--text-muted)]">
        Carpintería — Pino estufado — Marzo 2026
      </p>

      <p class="mb-6 mt-10 text-[length:var(--text-lg)] leading-[var(--leading-body)]">
        Mis abuelos pasan las tardes en el jardín, pero las sillas de plástico que
        usaban eran incómodas y ya se estaban rompiendo. Quise hacerles algo que durara
        más que yo: una silla baja, reclinada, donde cupiera un libro y una siesta.
      </p>
      <p class="mb-10 text-[length:var(--text-lg)] leading-[var(--leading-body)]">
        Usé pino estufado de un aserradero local. Cada duela está atornillada, no
        pegada, para poder reemplazarla si algún día se astilla. El tinte naranja fue
        idea de mi abuela — dijo que el jardín ya tenía suficiente verde.
      </p>
      <Image
        src={bancaPhoto}
        alt="La banca terminada en el jardín"
        widths={[800, 1400, 2000]}
        sizes="(min-width: 688px) 592px, 100vw"
        class="h-auto w-full rounded-[var(--radius-m)]"
      />
      <p
        class="mb-10 mt-3 text-xs italic text-[var(--text-faint)]"
      >
        La primera tarde de sol. El libro es de mi abuelo.
      </p>
      <p class="mb-14 text-[length:var(--text-lg)] leading-[var(--leading-body)]">
        Hice una segunda banca con los sobrantes, idéntica salvo por los nudos de la
        madera. Es la que está en venta aquí abajo. La primera no se vende: vive en el
        jardín de mis abuelos.
      </p>

      <!-- Ficha de compra -->
      <div
        class="grid items-center gap-6 rounded-[var(--radius-m)] bg-[var(--surface-card)] p-7 shadow-[var(--shadow-card)] sm:grid-cols-[auto_1fr_auto] sm:gap-8"
      >
        <div class="flex flex-col gap-1.5">
          <span class="meta-caps text-[var(--accent)]">Pieza única — 1 de 1</span>
          <span>
            <span
              class="text-[28px] font-extrabold leading-tight"
              style="font-family: var(--font-display)"
            >
              $2,400
            </span>
            <span class="meta-caps ml-1 text-[var(--text-faint)]">MXN</span>
          </span>
        </div>
        <div
          class="text-[11px] leading-[1.9] text-[var(--text-muted)] sm:border-l sm:border-[var(--border-soft)] sm:pl-6"
        >
          pino estufado · tinte + aceite<br />142 × 58 × 61 cm · 9.5 kg<br />envío CDMX
          incluido
        </div>
        <BuyBanca client:load />
      </div>
    </div>
  </main>
</BaseLayout>
