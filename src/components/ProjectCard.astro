---
// Réplica del componente ProjectCard del brand kit de forma.
// Si recibe `href` la tarjeta entera es un enlace; si no, es un artículo estático.
// `dark` es el modo noche del kit: tarjeta en tinta, separada por su borde y no
// por la sombra.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { tagClass } from '../lib/tagTone';

interface Props {
  cat: string; // categoría para el filtro de la bitácora
  meta: string[];
  title: string;
  note: string;
  tags: string[];
  image?: ImageMetadata;
  imageAlt?: string;
  placeholder?: string; // texto del hueco cuando no hay foto
  unique?: boolean; // etiqueta "pieza única"
  href?: string;
  dark?: boolean;
}

const {
  cat, meta, title, note, tags, image, imageAlt = '', placeholder,
  unique = false, href, dark = false,
} = Astro.props;
const El = href ? 'a' : 'article';
---

<El class:list={['project-card', dark && 'noche']} data-cat={cat} href={href}>
  {
    Astro.slots.has('media') ? (
      <slot name="media" />
    ) : image ? (
      <Image
        src={image}
        alt={imageAlt}
        widths={[400, 800]}
        sizes="(min-width: 768px) 340px, 100vw"
        class="block h-[210px] w-full object-cover"
      />
    ) : (
      <div class="hueco grid h-[210px] w-full place-items-center">
        <span class="meta-caps text-[11px] tracking-[0.1em]">{placeholder}</span>
      </div>
    )
  }
  <div class="flex flex-1 flex-col gap-2 px-5 pb-5 pt-[18px]">
    <span class="meta-caps meta-hilo">{meta.join(' — ')}</span>
    <h3
      class="titulo m-0 text-[length:var(--display-sm)] font-bold leading-[var(--leading-display)]"
      style="font-family: var(--font-display)"
    >
      {title}
    </h3>
    <p class="nota m-0 text-sm leading-[var(--leading-body)]">{note}</p>
    {
      (tags.length > 0 || unique) && (
        <div class="mt-auto flex flex-wrap items-center gap-2 pt-2">
          {tags.map((t) => (
            <span class={tagClass(t, dark)}>{t}</span>
          ))}
          {unique && (
            <span class:list={['tag', dark ? 'tag-blanco' : 'tag-tinta', 'ml-auto']}>pieza única</span>
          )}
        </div>
      )
    }
  </div>
</El>

<style>
  /* Modo día: tarjeta blanca separada por la sombra (ver .project-card en
     brand.css). Los colores de texto salen de los tokens del kit. */
  .meta-hilo { color: var(--accent); }
  .titulo { color: var(--text-body); }
  .nota { color: var(--text-muted); }
  .hueco { background: var(--hueso); }
  .hueco .meta-caps { color: var(--text-faint); }

  /* Modo noche: tinta con borde tenue, sin sombra. */
  .project-card.noche {
    background: var(--tinta);
    border: 1px solid #33332f;
    box-shadow: none;
    transition: border-color var(--duration-slow) var(--ease-out);
  }

  .project-card.noche:hover {
    border-color: #43433d;
    box-shadow: none;
  }

  .project-card.noche .meta-hilo { color: var(--azul-noche); }
  .project-card.noche .titulo { color: var(--blanco); }
  .project-card.noche .nota { color: var(--gris-claro); }
  .project-card.noche .hueco {
    background: #242421;
    border-bottom: 1px solid #33332f;
  }
  .project-card.noche .hueco .meta-caps { color: var(--gris); }
</style>
