---
// Columna "Más": avisos por correo arriba y después los enlaces. En el menú
// el formulario es solo una vista (la columna entera lleva a /mas).
interface Props {
  menu?: boolean;
}

const { menu = false } = Astro.props;
const Titulo = menu ? 'h2' : 'h1';
const Enlace = menu ? 'span' : 'a';
const filas = [
  { texto: 'Bitácora de la silla', href: '/banca' },
  { texto: 'Configura una lámpara', href: '/lampara' },
  { texto: 'Todos los trabajos', href: '/trabajos' },
  { texto: 'Quién está detrás', href: '/forma' },
  { texto: 'Escríbeme', href: 'mailto:hola@forma.mx' },
];
---

<div class="col-mas @container">
  <Titulo class="titulo-columna m-0">Más</Titulo>

  <div class="@2xl:mt-10 @2xl:grid @2xl:grid-cols-2 @2xl:gap-16">
    <form class="mt-5 @2xl:mt-0" novalidate>
      <p class="meta-caps m-0 text-[var(--accent)]">Avisos por correo</p>
      <p class="m-0 mt-2 max-w-[440px] text-[14px] leading-[var(--leading-body)] text-[var(--text-muted)] @2xl:text-[length:var(--text-lg)]">
        Sin algoritmo de por medio: te escribo cuando hay pieza nueva. Poco y de vez en cuando.
      </p>
      <div class="mt-3 flex gap-2 @2xl:mt-5">
        <input
          type="email"
          class="input-brand min-w-0 flex-1"
          placeholder="tu@correo.com"
          aria-label="Tu correo"
          tabindex={menu ? -1 : undefined}
        />
        <button type="button" class="btn btn-primary shrink-0" tabindex={menu ? -1 : undefined}>Avísame</button>
      </div>
    </form>

    <ul class="m-0 mt-8 list-none border-t border-[var(--border-soft)] p-0 text-[15px] @2xl:mt-0 @2xl:text-[length:var(--display-sm)]">
      {
        filas.map((f) => (
          <li class="border-b border-[var(--border-soft)] py-3 @2xl:py-4">
            <Enlace href={menu ? undefined : f.href} class="fila block">{f.texto}</Enlace>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .col-mas .titulo-columna {
    font-family: var(--font-display);
    font-size: 44px;
    font-weight: var(--weight-display);
    line-height: 0.95;
    letter-spacing: var(--tracking-display);
    color: var(--text-body);
  }

  @container (min-width: 42rem) {
    .col-mas .titulo-columna { font-size: clamp(72px, 12vw, 200px); line-height: 0.85; }
  }

  .col-mas .fila { color: var(--text-body); text-decoration: none; }
  .col-mas a.fila:hover { color: var(--accent); }
</style>
