# Cabeceras de seguridad para el sitio estático (Hostinger = Apache).
# Astro copia public/ a la raíz del build, así que este archivo llega al deploy.
<IfModule mod_headers.c>
  # La Content-Security-Policy la emite Astro como <meta> en cada página (con
  # los hashes de sus scripts de hidratación); ver security.csp en
  # astro.config.mjs. NO se duplica aquí como cabecera para no entrar en
  # conflicto (dos CSP se aplican por intersección y romperían las islands).
  # Estas cabeceras solo existen como header HTTP, no como <meta>:

  # Anti-clickjacking (equivalente a frame-ancestors, que <meta> ignora).
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
